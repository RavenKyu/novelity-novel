# Copy to .env and fill in. .env is git-ignored.

# Host port for the studio UI: the vite dev server (scripts/dev) or nn-studio-web-server
WEB_PORT=8000
BOOKSTORE_PORT=8001
# Trusted internal SSR/proxy target for host development (compose sets its own).
CORE_API_URL=http://localhost:8080

# Browser origins. Register each origin + /api/auth/google/callback in Google Cloud.
# Production: https://studio.novelity.kr, https://novelity.kr, https://admin.novelity.kr.
STUDIO_URL=http://localhost:8000
BOOKSTORE_URL=http://localhost:8001
ADMIN_URL=http://localhost:8002
# Public cookie sharing: novelity.kr in production; empty for localhost (host-only).
SESSION_DOMAIN=
# Public instance only. Admin deployments use a separate process with API_SURFACES=admin.
API_SURFACES=studio,store

# Google OAuth 2.0 client (type: Web application). Login is disabled while empty.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Session lifetime (Go duration)
SESSION_TTL=168h

# MongoDB root account (applied only when the data volume is first created)
MONGO_ROOT_USER=novelity
MONGO_ROOT_PASSWORD=novelity-dev
# Host port, bound to 127.0.0.1 only
MONGO_PORT=27017
# scripts/dev builds core-api's MONGO_URI (localhost) from the three values above.
# Set MONGO_URI here only to point local dev at a different MongoDB.

# Verified Google emails allowed to hold the admin role (comma-separated).
ADMIN_EMAILS=
