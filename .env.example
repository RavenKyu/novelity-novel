# Copy to .env and fill in. .env is git-ignored.

# Host port for the admin UI (nn-web-server)
WEB_PORT=8000

# Browser-facing origin of the admin. The Google OAuth redirect URI is
# ${PUBLIC_URL}/api/auth/google/callback — register exactly that in Google Cloud.
# Use https:// in production (session cookies then get the Secure flag).
PUBLIC_URL=http://localhost:8000

# Google OAuth 2.0 client (type: Web application). Login is disabled while empty.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Session lifetime (Go duration)
SESSION_TTL=168h

# MongoDB root account (applied only when the data volume is first created)
MONGO_ROOT_USER=novelity
MONGO_ROOT_PASSWORD=novelity-dev
# Host port, bound to 127.0.0.1 only
MONGO_PORT=27017
