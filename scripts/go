#!/bin/sh
# Run the Go toolchain: the local `go` if installed, otherwise golang:1.27-alpine in Docker.
# Usage (from a module dir): ../../scripts/go test ./...
set -e
if command -v go >/dev/null 2>&1; then
	exec go "$@"
fi
cache="${XDG_CACHE_HOME:-$HOME/.cache}/nn-go"
mkdir -p "$cache"
# Host network so tests can reach services published on localhost (e.g. MongoDB).
exec docker run --rm -u "$(id -u):$(id -g)" --network host \
	-e HOME=/tmp -e GOCACHE=/cache/build -e GOMODCACHE=/cache/mod \
	-e MONGO_TEST_URI \
	-v "$cache":/cache -v "$PWD":/src -w /src \
	golang:1.27-alpine go "$@"
